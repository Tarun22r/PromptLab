# Database
DATABASE_URL=sqlite:///./promptlab.db

# LLM provider configuration.
# Leave LLM_API_KEY empty to run entirely in Demo Mode (deterministic mock
# responses, no external calls, no key required).
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_DEFAULT_MODEL=gpt-4o-mini

# Comma-separated list is not supported directly by pydantic-settings' list
# parsing from env by default here; edit core/config.py if you need multiple
# origins beyond the Vite dev server default.
CORS_ORIGINS=["http://localhost:5173"]
